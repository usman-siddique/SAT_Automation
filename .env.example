# Application
# Used when running pytest directly. run_tests.bat overrides this after you
# select Sprint or Development.
BASE_URL=https://sprint.shineauto.info

# Test account - replace with your own development credentials
LOGIN_EMAIL=your_email@example.com
LOGIN_PASSWORD=your_password

# Dealer account - required only when Dealer tests are implemented/run
DEALER_LOGIN_EMAIL=dealer@example.com
DEALER_LOGIN_PASSWORD=your_dealer_password

# PayPal sandbox buyer account - required only for PayPal payment tests
PAYPAL_SANDBOX_EMAIL=your_sandbox_buyer@example.com
PAYPAL_SANDBOX_PASSWORD=your_sandbox_password

# Browser execution
BROWSER=chromium
HEADLESS=false

# Safety gate - keep false unless submissions are intentional
RUN_STATE_CHANGING_TESTS=false

# Optional Buy Flow path overrides. The defaults use Volkswagen for Paygent
# and Daihatsu for Bank Payment so created orders are easy to distinguish.
USED_CAR_PAYGENT_PATH=/used-cars/mk_volkswagen?sort_by=new_arrival&per_page=25&page=1&unreserved=1
USED_CAR_BANK_PATH=/used-cars/mk_daihatsu?sort_by=new_arrival&per_page=25&page=1&unreserved=1

# Frequently changing test records (store real values in your private .env)
AUCTION_CALCULATOR_STOCK_ID=
NON_STOLEN_VEHICLE_STOCK_ID=
